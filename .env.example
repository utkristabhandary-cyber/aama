# AAMS environment template — copy to `.env` and fill in your own values.
# The real `.env` file is git-ignored and MUST never be committed.
# Placeholder values only — nothing here is a real credential.
#
# Key:
#   [REQUIRED in production]  — Render/Vercel dashboard MUST set these.
#   [optional]                — has a safe default; set only to override.
#   [local default]           — development fallback when unset; production
#                               MUST override where noted.

# --- Django core ---
# DEBUG=true and no DJANGO_SECRET_KEY is safe only for local development.
# When DEBUG=false, DJANGO_SECRET_KEY is REQUIRED or the app refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# [REQUIRED in production] DJANGO_SECRET_KEY=CHANGE_ME
# [REQUIRED in production] DJANGO_DEBUG=false  ([local default] true)
# [REQUIRED in production] DJANGO_ALLOWED_HOSTS=.onrender.com  ([local default] localhost,127.0.0.1)
# [optional] DJANGO_TIME_ZONE=UTC
# [optional] DJANGO_SETTINGS_MODULE=config.settings.base  (wsgi.py/asgi.py already default to it;
#            manage.py defaults to config.settings.development for local work)

# --- PostgreSQL (Django) ---
# [REQUIRED in production] Render provides this; it takes precedence over DB_* below.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# [local default] Discrete variables used only when DATABASE_URL is unset:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=aams_db
# DB_USER=aams_user
# DB_PASSWORD=CHANGE_ME
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- CORS (Vercel frontend) ---
# [REQUIRED in production] Exact deployed frontend origin(s), comma-separated. Never "*".
# CORS_ALLOWED_ORIGINS=https://REPLACE-ME-VERCEL-APP.vercel.app
# ([local default] http://localhost:3000,http://127.0.0.1:3000)

# --- CSRF trusted origins (Django admin / browsable API over HTTPS) ---
# [REQUIRED in production] Exact backend origin(s), comma-separated.
# CSRF_TRUSTED_ORIGINS=https://REPLACE-ME-aams-api.onrender.com
# ([local default] empty)

# --- Demo provisioning (Render build only) ---
# [optional] OFF by default. When exactly "true", the Render build seeds the
# existing demo dataset via `seed_demo_data --quiet` (no password in logs).
# Demo provisioning ONLY — enable solely to initialize a demo environment,
# then set back to "false" and redeploy. Every run resets the demo admin
# account password. Never enable on a non-demo database.
# AAMS_SEED_DEMO_DATA=false

# --- Django backend API (frontend, Vercel) ---
# [REQUIRED in production, on Vercel] Base URL baked into the Vite bundle at
# build time — changing it requires a Vercel redeploy. Path component included.
# VITE_API_BASE_URL=https://REPLACE-ME-aams-api.onrender.com/api
# ([local default] http://127.0.0.1:8000/api)

# --- Auth hardening ---
# Token lifetime in seconds before a login token expires (30 days default).
# Set to 0 ONLY for local development to disable expiry; production should
# always configure a concrete lifetime.
# [optional] AAMS_TOKEN_TTL_SECONDS=2592000

# Login brute-force throttling (per account+IP and per IP respectively).
# [optional] AAMS_LOGIN_THROTTLE_RATE=5/min
# [optional] AAMS_LOGIN_IP_THROTTLE_RATE=100/min

# --- Production security flags (all default OFF = development-safe) ---
# [REQUIRED in production] Turn these on when the API is served over HTTPS.
# They are read by backend/config/settings/base.py. SSL is expected to
# terminate at the proxy; redirect + HSTS then apply at the Django hop from
# behind the proxy's forwarded-proto header.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=1
