# AAMS environment template — copy to `.env` and fill in your own values.
# The real `.env` file is git-ignored and MUST never be committed.

# --- Django core ---
# DEBUG=true and no DJANGO_SECRET_KEY is safe only for local development.
# When DEBUG=false, DJANGO_SECRET_KEY is REQUIRED or the app refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=CHANGE_ME
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_TIME_ZONE=UTC

# --- PostgreSQL (Django) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=aams_db
# DB_USER=aams_user
# DB_PASSWORD=CHANGE_ME
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- CORS (Vite frontend) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Django backend API (frontend) ---
# Base URL used by src/services/apiClient.ts. Defaults to
# http://127.0.0.1:8000/api when unset. Path component is included.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Auth hardening ---
# Token lifetime in seconds before a login token expires (30 days default).
# Set to 0 ONLY for local development to disable expiry; production should
# always configure a concrete lifetime.
# AAMS_TOKEN_TTL_SECONDS=2592000

# Login brute-force throttling (per account+IP and per IP respectively).
# AAMS_LOGIN_THROTTLE_RATE=5/min
# AAMS_LOGIN_IP_THROTTLE_RATE=100/min

# --- Production security flags (all default OFF = development-safe) ---
# Turn these on when the API is served over HTTPS in production. They are
# read by backend/config/settings/base.py. SSL is expected to terminate at
# the reverse proxy; redirect + HSTS then apply at the Django hop from behind
# the proxy's forwarded-proto header.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=1